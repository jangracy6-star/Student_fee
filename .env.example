# Supabase project (Dashboard → Project Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# First password for the admin accounts (min 8 characters).
# Used only while an admin has no password yet — change it in the app after signing in.
ADMIN_PASSWORD=

# Admin emails (comma-separated). Default: bavayuva789@gmail.com,dominova.office@gmail.com
ADMIN_EMAILS=

# Optional: secret used to sign login sessions (defaults to one derived from the Supabase key)
SESSION_SECRET=

# How many customers' WhatsApp can run at once. Each needs ~250 MB of memory; 1 fits Render's free plan.
WHATSAPP_MAX_ACTIVE=1

# Timezone for reminder days and the "current month" (default: Asia/Kolkata)
TIMEZONE=Asia/Kolkata

PORT=3000
