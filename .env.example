# Supabase project (Dashboard → Project Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shown in the app header and in WhatsApp reminder messages
INSTITUTION_NAME=Student Academy

# Password for the dashboard. Leave empty to disable login (NOT recommended when deployed online)
ADMIN_PASSWORD=

# Optional: secret used to sign login sessions (defaults to one derived from ADMIN_PASSWORD)
SESSION_SECRET=

# Timezone for the monthly cron job and "current month" (default: Asia/Kolkata)
TIMEZONE=Asia/Kolkata

PORT=3000
